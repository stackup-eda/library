// @stackup/radio/xbee3 — Digi XBee 3 Zigbee XB3-24Z8UT-J through-hole module. A 2.4 GHz
// 802.15.4 radio with UART and SPI interfaces on the twenty-pin XBee footprint. The XB3-24Z8UM
// surface-mount Micro module is `xbee3-micro`, at the end of this file.
//
// The custom symbol and footprint come from the Amidala board.
//
// SPI_ATTN also selects boot mode. Digi’s hardware reference (90001543) requires it to stay
// high during reset; a net-level requirement and default pull-up enforce this.
//
// The default supply block places the manual’s 1 µF, 47 pF, and 10 µF capacitors near VCC, with
// the smallest closest.
//
// An optional `with reset-filter` block adds the Amidala shield’s 10 kΩ pull-up and 100 Ω / 100
// nF reset filter. Use the pull-up alone when driving RESET from a GPIO.

use "@stackup/passives"

part xbee3-zigbee {
    symbol "Xbee3:XB3-24Z8UT-J"
    reference U
    value "XBee3"
    datasheet "https://www.digi.com/resources/documentation/digidocs/pdfs/90001543.pdf"
    description "XBee 3 Zigbee 3.0 module, 2.4 GHz, U.FL antenna, through-hole"
    manufacturer "Digi International"
    order mpn="XB3-24Z8UT-J" mouser="888-XB3-24Z8UT-J"

    pin VCC power_in
    pin DOUT output symbol="DOUT/DIO13"
    pin DIN input symbol="DIN/~{CONFIG}/DIO14"
    pin SPI_MISO output
    pin RESET input
    pin RSSI_PWM output symbol="RSSI_PWM/DIO10"
    pin PWM1 output symbol="PWM1/DIO11"
    pin RESERVED1 passive symbol="[RESERVED]_1"
    pin DTR input
    pin GND power_in
    pin SPI_MOSI input
    pin CTS output symbol="~{CTS}/DIO7"
    pin ON_SLEEP output
    pin RESERVED2 passive symbol="[RESERVED]_2"
    pin ASSOCIATE output symbol="ASSOCIATE/DIO5"
    pin RTS input symbol="~{RTS}/DIO6"
    pin SPI_SSEL input
    pin SPI_CLK input
    pin SPI_ATTN output {
        role strap sampled=reset pull=none \
            note="BOOTMODE — must not be low at reset (90001543); the module's data-ready line afterwards"
        require net.rest high
    }
    pin AD0 bidirectional symbol="AD0_/DIO0"

    package tht footprint="stackup:XB324Z8UTJ" {
        pad VCC 1
        pad DOUT 2
        pad DIN 3
        pad SPI_MISO 4
        pad RESET 5
        pad RSSI_PWM 6
        pad PWM1 7
        pad RESERVED1 8
        pad DTR 9
        pad GND 10
        pad SPI_MOSI 11
        pad CTS 12
        pad ON_SLEEP 13
        pad RESERVED2 14
        pad ASSOCIATE 15
        pad RTS 16
        pad SPI_SSEL 17
        pad SPI_CLK 18
        pad SPI_ATTN 19
        pad AD0 20
    }

    // 2.1–3.6 V supply; 40 mA budget for transmission at +8 dBm.
    port vcc type=power {
        require net.voltage min="2.1V" max="3.6V"
        add net.draw "40mA"
        line rail pin=VCC
        line gnd pin=GND
    }

    port spi type=spi {
        line sck pin=SPI_CLK
        line mosi pin=SPI_MOSI
        line miso pin=SPI_MISO
    }
    // Host-driven chip select, connected separately from the SPI bus.
    port cs type=output pin=SPI_SSEL
    // UART interface: the module transmits on DOUT and drives CTS.
    port uart type=uart {
        line tx pin=DOUT
        line rx pin=DIN
        line rts pin=RTS
        line cts pin=CTS
    }
    // Host-driven DTR: high requests pin sleep.
    port sleep-rq type=output pin=DTR
    // Module status outputs: SPI data ready and sleep state.
    port attn pin=SPI_ATTN
    port on-sleep pin=ON_SLEEP
    // Active-low reset with an internal pull-up.
    port reset pin=RESET

    // Application circuits

    // Manual’s supply capacitors: 1 µF and 47 pF closest to VCC, with 10 µF nearby.
    block supply {
        default
        place decouple Cvcc anchor=VCC node=VCC rail=vcc value="1µF" footprint="Capacitor_SMD:C_0603_1608Metric" \
            note="VCC decoupling — place the specified 1 µF close to VCC, beside the 47 pF"
        place decouple Chf anchor=VCC node=VCC rail=vcc value="47pF" \
            note="VCC decoupling — the manual's 47 pF, nearest the module"
        place bulk Cbulk anchor=VCC node=VCC rail=vcc value="10µF" footprint="Capacitor_SMD:C_0603_1608Metric" \
            note="VCC bulk capacitance — 10 µF per the manual"
    }

    // Pull SPI_ATTN high during reset; the module drives it afterward.
    block bootmode {
        default
        place pull-up Rattn anchor=SPI_ATTN node=SPI_ATTN rail=vcc value="10kΩ" \
            note="BOOTMODE strap — SPI_ATTN must not be low at reset"
    }

    // Optional reset filter: 10 kΩ pull-up, 100 Ω series resistor, and 100 nF capacitor,
    // approximately 160 Hz. Use when RESET has no external driver.
    block reset-filter {
        place resistor Rrc anchor=RESET value="100Ω" intent=series note="reset RC — the series element"
        place pull-up Rrst anchor=Rrc.A node=Rrc.a rail=vcc value="10kΩ" note="reset pull-up"
        place filter Crc anchor=Rrc.A node=Rrc.a rail=vcc value="100nF" note="reset RC — ~160 Hz with 100 Ω"
        circuit Rrst Rrc RESET
        set Rrst net.name "RST_PU"
    }
}

// Digi XBee 3 PRO Zigbee 3.0 Micro, U.FL antenna. The Micro's pin numbers differ, so this model
// takes them from Digi 90001543 pp.42-44; it keeps xbee3-zigbee's pin names so the board's nets
// read the same. The -J parts are the +8 dBm non-PRO modules. The reserved pads (17-20, 22) stay
// open, as Digi requires.
part xbee3-micro {
    symbol "Xbee3:XB3-24Z8UM"
    reference U
    value "XBee3 PRO Micro"
    datasheet "https://docs.digi.com/resources/documentation/digidocs/pdfs/90001543.pdf"
    description "XBee 3 PRO Zigbee 3.0 module, +19 dBm, 2.4 GHz, U.FL antenna, Micro 13.54x19.30mm castellated"
    manufacturer "Digi International"
    order mpn="XB3-24Z8UM" lcsc=C5833776

    pin GND power_in
    pin VCC power_in
    pin DOUT output symbol="DOUT/DIO13"
    pin DIN input symbol="DIN/~{CONFIG}/DIO14"
    pin DIO12 bidirectional
    pin RESET input symbol="~{RESET}"
    pin RSSI_PWM output symbol="RSSI_PWM/DIO10"
    pin PWM1 output symbol="PWM1/DIO11"
    pin DTR input symbol="~{DTR}/SLEEP_RQ/DIO8"
    pin SPI_ATTN output symbol="SPI_~{ATTN}/~{BOOTMODE}/DIO19" {
        role strap sampled=reset pull=none \
            note="BOOTMODE: must not be low at reset (90001543); the module's data-ready line afterwards"
        require net.rest high
    }
    pin SPI_CLK input symbol="SPI_CLK/DIO18"
    pin SPI_SSEL input symbol="SPI_~{SSEL}/DIO17"
    pin SPI_MOSI input symbol="SPI_MOSI/DIO16"
    pin SPI_MISO output symbol="SPI_MISO/DIO15"
    pin DIO4 bidirectional
    pin CTS output symbol="~{CTS}/DIO7"
    pin ON_SLEEP output symbol="ON/~{SLEEP}/DIO9"
    pin ASSOCIATE output symbol="ASSOCIATE/DIO5"
    pin RTS input symbol="~{RTS}/DIO6"
    pin AD3 bidirectional symbol="AD3/DIO3"
    pin AD2 bidirectional symbol="AD2/DIO2"
    pin AD1 bidirectional symbol="AD1/DIO1"
    pin AD0 bidirectional symbol="AD0/DIO0"
    pin RF passive

    package micro footprint="stackup:XB3-24Z8UM" {
        pad GND 1
        pad VCC 2
        pad DOUT 3
        pad DIN 4
        pad DIO12 5
        pad RESET 6
        pad RSSI_PWM 7
        pad PWM1 8
        pad DTR 9
        pad GND 10
        pad SPI_ATTN 11
        pad GND 12
        pad SPI_CLK 13
        pad SPI_SSEL 14
        pad SPI_MOSI 15
        pad SPI_MISO 16
        pad GND 21
        pad DIO4 23
        pad CTS 24
        pad ON_SLEEP 25
        pad ASSOCIATE 26
        pad RTS 27
        pad AD3 28
        pad AD2 29
        pad AD1 30
        pad AD0 31
        pad GND 32
        pad RF 33
        pad GND 34
    }

    // 2.1-3.6 V supply; 140 mA transmitting at +19 dBm (90001543, electrical specifications).
    port vcc type=power {
        require net.voltage min="2.1V" max="3.6V"
        add net.draw "140mA"
        line rail pin=VCC
        line gnd pin=GND
    }

    port spi type=spi {
        line sck pin=SPI_CLK
        line mosi pin=SPI_MOSI
        line miso pin=SPI_MISO
    }
    port cs type=output pin=SPI_SSEL
    port sleep-rq type=output pin=DTR
    port attn pin=SPI_ATTN
    port on-sleep pin=ON_SLEEP
    port reset pin=RESET
}
