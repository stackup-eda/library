// @stackup/connector/header — plain pin headers, one part per size.

// Generic numbered headers, with one part per size because each part has a fixed pin list.
// Every pin has a terminal port with the same name: `J.2` refers to position 2.

part conn-1x2 {
    symbol "Connector_Generic:Conn_01x02"
    reference J
    pin 1 passive
    pin 2 passive
    port 1 pin=1
    port 2 pin=2
    package header footprint="PinHeader_1x02_P2.54mm_Vertical" {
        pad 1 1
        pad 2 2
    }
}

