// TI SN74LVC1G32 single OR gate. SC-70 is the default; SOT-23 is easier to hand solder.

use "@stackup/passives"

part lvc1g32 {
    // Optional child reference names; null keeps automatic numbering.
    param ref-supply-Cvcc text default=#null

    symbol "74xGxx:74LVC1G32"
    reference U
    datasheet "https://www.ti.com/lit/gpn/sn74lvc1g32"
    description "Single 2-input OR gate"
    manufacturer "Texas Instruments"
    pin A input required
    pin B input required
    pin GND power_in
    pin Y output
    pin VCC power_in
    package sc70 footprint="Package_TO_SOT_SMD:SOT-353_SC-70-5" {
        pad A 1
        pad B 2
        pad GND 3
        pad Y 4
        pad VCC 5
        order mpn=SN74LVC1G32DCKR mouser="595-SN74LVC1G32DCKR"
    }
    package sot23 footprint="Package_TO_SOT_SMD:SOT-23-5" {
        pad A 1
        pad B 2
        pad GND 3
        pad Y 4
        pad VCC 5
        order mpn=SN74LVC1G32DBVR mouser="595-SN74LVC1G32DBVR"
    }
    port vcc type=power {
        require net.voltage min="1.65V" max="5.5V"
        add net.draw "10µA"
        line rail pin=VCC
        line gnd pin=GND
    }
    port a pin=A
    port b pin=B
    port y type=output pin=Y
    block supply {
        default
        place bypass Cvcc anchor=VCC node=VCC rail=vcc value="100nF" designator=ref-supply-Cvcc
    }
}
