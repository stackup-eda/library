// @stackup/logic/lv1t125 — TI SN74LV1T125 single buffer with translating inputs, SOT-23-5.

use "@stackup/passives"

// TI SN74LV1T125, a single tri-state buffer whose inputs read 3.3 V logic as high at any supply
// (VIH at most 2.03 V up to 5.0 V, 2.11 V at 5.5 V) and whose output drives to its own supply. The
// SN74AHCT1G125 (`@stackup/logic/ahct1g125`) does the same job but asks for 4.5 V; this one lifts
// 3.3 V logic onto a 5 V rail that may sag well below that.
// Same SOT-23-5 pinout as the AHCT part: 1 OE, 2 A, 3 GND, 4 Y, 5 VCC (SCLS745D, Figure 5-1).
part lv1t125 {
    symbol "74xGxx:74AHCT1G125"
    reference U
    datasheet "https://www.ti.com/lit/ds/symlink/sn74lv1t125.pdf"
    description "Single bus buffer gate with 3-state output, translating inputs, 1.6-5.5 V"
    manufacturer "Texas Instruments"
    order mpn=SN74LV1T125DBVR mouser="595-SN74LV1T125DBVR"

    pin OE input required symbol="~{OE}"
    pin A input
    pin GND power_in
    pin Y output
    pin VCC power_in

    package sot23-5 footprint="Package_TO_SOT_SMD:SOT-23-5" {
        pad OE 1
        pad A 2
        pad GND 3
        pad Y 4
        pad VCC 5
    }

    port vcc type=power {
        require net.voltage min="1.6V" max="5.5V"
        line rail pin=VCC
        line gnd pin=GND
    }
    port in pin=A
    port out type=output pin=Y

    block supply {
        default
        place bypass Cvcc anchor=VCC node=VCC rail=vcc value="100nF"
    }

    // Output enable low: the buffer always drives.
    block always-on {
        default
        circuit OE vcc.gnd
    }
}
