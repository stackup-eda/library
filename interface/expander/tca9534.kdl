// @stackup/interface/expander/tca9534 — 8-channel I²C GPIO expander. Address pins A0–A2
// select one of eight addresses (0x20–0x27); INT is open-drain with a default pull-up.

use "@stackup/passives"

part tca9534 {
    symbol "Interface_Expansion:TCA9534"
    reference U
    datasheet "https://www.ti.com/lit/gpn/tca9534"
    manufacturer "Texas Instruments"
    description "8-channel I²C GPIO expander"
    order mpn=TCA9534PWR mouser="595-TCA9534PWR" lcsc=C783615
    param offset number default=0
    assert "offset >= 0 && offset <= 7" message="I²C address offset must be 0–7"
    derive address "0x20 + offset"

    pin A0 input required
    pin A1 input required
    pin A2 input required
    pin P0 bidirectional
    pin P1 bidirectional
    pin P2 bidirectional
    pin P3 bidirectional
    pin GND power_in
    pin P4 bidirectional
    pin P5 bidirectional
    pin P6 bidirectional
    pin P7 bidirectional
    pin INT open_collector symbol="~{INT}"
    pin SCL input
    pin SDA bidirectional
    pin VDD power_in

    package tssop16 footprint="Package_SO:TSSOP-16_4.4x5mm_P0.65mm" {
        pad A0 1
        pad A1 2
        pad A2 3
        pad P0 4
        pad P1 5
        pad P2 6
        pad P3 7
        pad GND 8
        pad P4 9
        pad P5 10
        pad P6 11
        pad P7 12
        pad INT 13
        pad SCL 14
        pad SDA 15
        pad VDD 16
    }

    port vdd type=power {
        require net.voltage min="1.65V" max="5.5V"
        add net.draw "1mA"
        line rail pin=VDD
        line gnd pin=GND
    }
    port i2c type=i2c {
        claim signal.address address
        line sda pin=SDA
        line scl pin=SCL
    }
    port int pin=INT
    port p0 pin=P0
    port p1 pin=P1
    port p2 pin=P2
    port p3 pin=P3
    port p4 pin=P4
    port p5 pin=P5
    port p6 pin=P6
    port p7 pin=P7

    block supply {
        default
        place decouple Cvdd node=VDD rail=vdd value="1µF"
        place pull-up Rint node=INT rail=vdd value="4.7kΩ"
    }
    block a0-low { when "offset == 0 || offset == 2 || offset == 4 || offset == 6"; circuit A0 vdd.gnd }
    block a0-high { when "offset == 1 || offset == 3 || offset == 5 || offset == 7"; circuit A0 vdd.rail }
    block a1-low { when "offset == 0 || offset == 1 || offset == 4 || offset == 5"; circuit A1 vdd.gnd }
    block a1-high { when "offset == 2 || offset == 3 || offset == 6 || offset == 7"; circuit A1 vdd.rail }
    block a2-low { when "offset == 0 || offset == 1 || offset == 2 || offset == 3"; circuit A2 vdd.gnd }
    block a2-high { when "offset == 4 || offset == 5 || offset == 6 || offset == 7"; circuit A2 vdd.rail }
}
