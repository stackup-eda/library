// @stackup/power/buck/tpsm53603 — TI TPSM53603 3 A buck power module.
// The inductor is inside the module. Input/output capacitors and the feedback
// divider remain external. The exposed PGND pad needs a good thermal connection.

use "@stackup/passives"

part tpsm53603 {
    // Optional child reference names; null keeps automatic numbering.
    param ref-supply-Cin1 text default=#null
    param ref-supply-Cin2 text default=#null
    param ref-supply-Cout1 text default=#null
    param ref-supply-Cout2 text default=#null
    param ref-feedback-Rtop text default=#null
    param ref-feedback-Rbottom text default=#null
    param ref-uvlo-Ren-top text default=#null
    param ref-uvlo-Ren-bottom text default=#null

    symbol "Converter_DCDC:TPSM53603RDA"
    reference U
    datasheet "https://www.ti.com/lit/ds/symlink/tpsm53603.pdf"
    description "36V, 3A adjustable buck module with integrated inductor, B3QFN-15"
    manufacturer "Texas Instruments"
    order mpn=TPSM53603RDAR mouser="595-TPSM53603RDAR"

    param vout voltage default="5V"
    param enable-above voltage default="0V"
    // Divider values round to E96; `actual` is what the rounded divider makes, and is what the
    // output port declares.
    derive rbottom "e96(10kΩ / (vout / 1V - 1))"
    derive actual "1V * (1 + 10kΩ / rbottom)"
    derive renbottom "e96(100kΩ / (enable-above / 1.23V - 1))"
    derive input "out.draw * out.voltage / (0.9 * in.voltage.min)"

    pin VIN power_in
    pin EN input required
    pin PGND power_in
    pin DNC no_connect
    pin PGOOD open_collector
    pin VOUT power_out
    pin FB input required
    pin AGND power_in
    pin V5V output
    package b3qfn footprint="Package_DFN_QFN:Texas_B3QFN-14-1EP_5x5.5mm_P0.65mm" {
        pad VIN 1
        pad VIN 14
        pad EN 2
        pad PGND 3
        pad PGND 10
        pad PGND 11
        pad PGND 15
        pad DNC 4
        pad DNC 5
        pad PGOOD 6
        pad VOUT 7
        pad VOUT 8
        pad FB 9
        pad AGND 12
        pad V5V 13
    }

    port in type=power {
        require net.voltage min="3.8V" max="36V"
        add net.draw input
        line rail pin=VIN
        line gnd pin=PGND
    }
    port out type=power {
        set net.voltage actual
        assert "vout >= 1V && vout <= 7V" message="TPSM53603 output setting must be 1-7V"
        assert "draw <= 3A" message="TPSM53603 output load {draw} exceeds 3A"
        line rail pin=VOUT
        line gnd pin=PGND
    }
    port pgood pin=PGOOD

    block supply {
        default
        place bulk Cin1 anchor=VIN@1 node=VIN rail=in value="10µF" footprint="Capacitor_SMD:C_1210_3225Metric" designator=ref-supply-Cin1
        place bulk Cin2 anchor=VIN@1 node=VIN rail=in value="10µF" footprint="Capacitor_SMD:C_1210_3225Metric" designator=ref-supply-Cin2
        place bulk Cout1 anchor=VOUT@7 node=VOUT rail=out value="47µF" footprint="Capacitor_SMD:C_1210_3225Metric" designator=ref-supply-Cout1
        place bulk Cout2 anchor=VOUT@7 node=VOUT rail=out value="47µF" footprint="Capacitor_SMD:C_1210_3225Metric" designator=ref-supply-Cout2
        circuit AGND PGND
    }
    block feedback {
        default
        place resistor Rtop anchor=FB value="10kΩ" intent=divider designator=ref-feedback-Rtop
        place resistor Rbottom anchor=FB value=rbottom intent=divider designator=ref-feedback-Rbottom
        circuit VOUT Rtop FB Rbottom AGND
    }
    block always-on {
        when "enable-above == 0V"
        circuit EN VIN
    }
    block uvlo {
        when "enable-above > 0V"
        place resistor Ren-top anchor=EN value="100kΩ" intent=divider designator=ref-uvlo-Ren-top
        place resistor Ren-bottom anchor=EN value=renbottom intent=divider designator=ref-uvlo-Ren-bottom
        circuit VIN Ren-top EN Ren-bottom PGND
    }
    block unused {
        default
        nc DNC V5V note="V5V is the internal LDO output; leave it unloaded"
    }
}
